{
  "name": "@solomonneas/librenms-mcp",
  "version": "0.2.2",
  "description": "librenmsctrl operator CLI for LibreNMS with an MCP-compatible adapter",
  "keywords": [
    "librenms",
    "librenmsctrl",
    "network-monitoring",
    "observability",
    "mcp",
    "model-context-protocol"
  ],
  "type": "module",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.5.17",
      "pluginSdkVersion": "2026.5.17"
    }
  },
  "bin": {
    "librenmsctrl": "dist/cli.js",
    "librenmsctl": "dist/cli.js",
    "librenms-mcp": "dist/mcp-bin.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "start": "node dist/cli.js mcp",
    "dev": "tsx mcp-bin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sinclair/typebox": "^0.34.0",
    "effect": "^3.21.4",
    "undici": "^7.28.0"
  },
  "peerDependencies": {
    "openclaw": "^2026.4.22"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lidless-labs/effect-operator-kit": "github:lidless-labs/effect-operator-kit#5db1049f26e14bfbe49cfd9631cc84cca7f7247b",
    "@types/node": "^25.6.2",
    "openclaw": "2026.8.35",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidless-labs/librenmsctrl.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild@^0.27.0": "0.27.2",
    "openclaw": {
      "@modelcontextprotocol/sdk": "^1.32.2",
      "undici": "^8.12.3",
      "zod": "^4.6.7"
    }
  }
}
